// TennVice - Home Maintenance Subscription Platform
// Database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users ───────────────────────────────────────────────────────────────────
// Role values: ADMIN | TECHNICIAN | CUSTOMER

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String      @default("CUSTOMER")
  adminRole     String?     // "SENIOR" | "STANDARD" — only set for ADMIN users; null treated as SENIOR
  phone         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  accounts      Account[]
  sessions      Session[]
  customer      Customer?
  technician    Technician?
}

// ─── Customers & Properties ───────────────────────────────────────────────────
// SubscriptionTier values: BASIC | STANDARD | PLUS | PREMIUM
//   BASIC    — £15/month, 2 visits, minor checks, 20% discount
//   STANDARD — £22/month, 2 visits, boiler check (no service), 20% discount
//   PLUS     — £27/month, flexible visits, flushing, 30% discount
//   PREMIUM  — £40-50/month, all + boiler service, 40% discount, 2 emergency call-outs
// SubscriptionStatus values: ACTIVE | PAUSED | CANCELLED

model Customer {
  id                 String     @id @default(cuid())
  userId             String     @unique
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionTier   String     @default("BASIC")
  subscriptionStatus String     @default("ACTIVE")
  visitsPerYear      Int        @default(2)
  emergencyCallouts  Int        @default(0)
  discountPercent    Int        @default(20)
  // GoCardless Direct Debit
  gcBillingRequestId String?    // temporary reference during redirect flow
  gcMandateId        String?    // e.g. MD0000XXXX
  gcSubscriptionId   String?    // e.g. SB0000XXXX
  ddStatus           String     @default("NONE")  // NONE | PENDING | ACTIVE | CANCELLED | FAILED
  ddSetupAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  properties         Property[]
}

model Property {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  address      String
  postcode     String
  propertyType   String   @default("House")
  ownershipType  String   @default("OWNER")
  bedrooms       Int?
  notes          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  visits       Visit[]
}

// ─── Technicians ──────────────────────────────────────────────────────────────

model Technician {
  id              String                   @id @default(cuid())
  userId          String                   @unique
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualification   String?
  licenceNumber   String?
  address         String?
  nokName         String?
  nokPhone        String?
  nokRelationship String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  visits          Visit[]
  certificates    TechnicianCertificate[]
}

model TechnicianCertificate {
  id           String     @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  fileName     String     // Original filename
  fileUrl      String     // Served path e.g. /uploads/certificates/abc.pdf
  fileType     String     // MIME type

  // AI extraction results
  aiCertName   String?    // Certificate title
  aiIssuer     String?    // Issuing body
  aiHolder     String?    // Holder name on cert
  aiLicenceNo  String?    // Cert/licence number
  aiIssuedAt   String?    // Issue date (string)
  aiExpiresAt  String?    // Expiry date (string)
  aiSummary    String?    // AI narrative summary
  aiConfidence String?    // HIGH | MEDIUM | LOW
  aiValid      Boolean    @default(false)

  // Admin review
  status       String     @default("PENDING")  // PENDING | VERIFIED | REJECTED

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ─── Visits & Reports ─────────────────────────────────────────────────────────
// VisitStatus values: SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
// VisitType   values: ROUTINE_PLUMBING | ROUTINE_ELECTRICAL | ROUTINE_BOTH | EMERGENCY | BOILER_SERVICE

model Visit {
  id           String      @id @default(cuid())
  propertyId   String
  property     Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  technicianId String?
  technician   Technician? @relation(fields: [technicianId], references: [id])
  scheduledAt  DateTime
  completedAt  DateTime?
  status       String      @default("SCHEDULED")
  type         String      @default("ROUTINE_BOTH")
  isEmergency  Boolean     @default(false)
  report       Report?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// CheckResult values: PASS | ADVISORY | FAIL | NOT_CHECKED

model Report {
  id                 String   @id @default(cuid())
  visitId            String   @unique
  visit              Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  // Plumbing checks
  pipesCheck         String   @default("NOT_CHECKED")
  pipesNotes         String?
  heatingCheck       String   @default("NOT_CHECKED")
  heatingNotes       String?
  waterPumpCheck     String   @default("NOT_CHECKED")
  waterPumpNotes     String?
  cylinderCheck      String   @default("NOT_CHECKED")
  cylinderNotes      String?
  pressureCheck      String   @default("NOT_CHECKED")
  pressureNotes      String?
  leakageCheck       String   @default("NOT_CHECKED")
  leakageNotes       String?

  // Electrical checks
  electricalCheck    String   @default("NOT_CHECKED")
  electricalNotes    String?
  usageAdviceGiven   Boolean  @default(false)

  // Boiler
  boilerCheck        String   @default("NOT_CHECKED")
  boilerNotes        String?
  boilerServiced     Boolean  @default(false)

  // Flushing
  systemFlushed      Boolean  @default(false)
  cylinderFlushed    Boolean  @default(false)

  // Overall
  overallNotes       String?
  recommendations    String?
  partsRequired      String?
  followUpRequired   Boolean  @default(false)
  signedByTechnician Boolean  @default(false)
  signedAt           DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
